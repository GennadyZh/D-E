---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import services from '../data/services.json';
import reviews from '../data/reviews.json';
import { pages } from '../lib/content';
import { withBase } from '../lib/paths';

const { frontmatter, Content } = pages.home;
const previewServices = services.slice(0, 3);
const previewReviews = reviews.slice(0, 2);
---

<BaseLayout title={site.title} description={frontmatter.description} fullBleed>
	<Hero
		brand={site.brand}
		tagline={site.tagline}
		title={frontmatter.heroTitle}
		lead={frontmatter.heroLead}
	/>

	<section class="home-band">
		<div class="home-inner">
			<div class="intro reveal">
				<p class="eyebrow">Как я работаю</p>
				<div class="prose">
					<Content />
				</div>
				<div class="cta-row">
					<a class="btn btn-primary" href={withBase('/kontakty/')}>Написать</a>
					<a class="btn btn-ghost" href={withBase('/ceny/')}>Пакеты и цены</a>
				</div>
			</div>

			<div class="service-strip reveal">
				<p class="eyebrow">Услуги</p>
				<h2 class="section-title">Форматы праздника</h2>
				<ul class="service-list">
					{
						previewServices.map((item) => (
							<li>
								<a class="service-card-link" href={withBase(`/uslugi/${item.slug}/`)}>
									<h3>{item.title}</h3>
									<p>{item.summary}</p>
								</a>
							</li>
						))
					}
				</ul>
				<a class="text-link" href={withBase('/uslugi/')}>Все услуги</a>
			</div>

			<div class="quote-strip reveal">
				<p class="eyebrow">Отзывы</p>
				<div class="quotes">
					{
						previewReviews.map((item) => (
							<figure>
								<blockquote>{item.text}</blockquote>
								<figcaption>
									<strong>{item.name}</strong>
									<span>{item.event}</span>
								</figcaption>
							</figure>
						))
					}
				</div>
				<a class="text-link" href={withBase('/otzyvy/')}>Читать отзывы</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.home-band {
		padding: var(--space-xl) 0 var(--space-2xl);
	}

	.home-inner {
		width: min(100% - 2rem, var(--max));
		margin-inline: auto;
		display: grid;
		gap: var(--space-xl);
	}

	.service-list {
		list-style: none;
		margin: 0 0 var(--space-md);
		padding: 0;
		display: grid;
		gap: var(--space-md);
	}

	.service-list li {
		padding-block: 0.35rem;
		border-top: 1px solid var(--line);
	}

	.service-card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.service-card-link:hover {
		color: inherit;
	}

	.service-card-link:hover h3 {
		color: var(--wine);
	}

	.service-list h3 {
		margin: 0.85rem 0 0.35rem;
		font-size: 1.2rem;
		color: var(--wine-deep);
		transition: color 0.25s var(--ease-out);
	}

	.service-list p {
		margin: 0;
		color: var(--ink-soft);
		max-width: 40rem;
	}

	.quotes {
		display: grid;
		gap: var(--space-lg);
		margin-bottom: var(--space-md);
	}

	blockquote {
		margin: 0;
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		line-height: 1.45;
		font-family: var(--font-display);
		font-weight: 500;
		color: var(--ink);
		max-width: 34rem;
	}

	figcaption {
		margin-top: 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		color: var(--muted);
		font-size: 0.92rem;
	}

	.text-link {
		font-weight: 700;
		text-decoration: none;
		border-bottom: 1px solid color-mix(in srgb, var(--gold) 70%, transparent);
		padding-bottom: 0.1rem;
	}

	@media (min-width: 900px) {
		.service-list {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-lg);
		}

		.service-list li {
			border-top: none;
			border-left: 1px solid var(--line);
			padding: 0 0 0 var(--space-md);
		}

		.service-list li:first-child {
			border-left: none;
			padding-left: 0;
		}

		.quotes {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
