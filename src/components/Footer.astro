---
import { site, nav } from '../data/site';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div>
			<p class="footer-brand">{site.brand}</p>
			<p class="footer-tag">{site.tagline}</p>
			<p class="footer-meta">{site.city}</p>
		</div>
		<nav aria-label="Навигация в подвале">
			<ul>
				{nav.map((item) => (
					<li>
						<a href={withBase(item.href)}>{item.label}</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="footer-contact">
			<a href={`mailto:${site.email}`}>{site.email}</a>
			<a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>
		</div>
	</div>
	<p class="footer-copy">© {year} {site.brand}. Контент легко правится в Markdown и JSON.</p>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper-deep) 70%, transparent);
		padding: var(--space-lg) 0 var(--space-md);
		position: relative;
		z-index: 1;
	}

	.footer-inner {
		width: min(100% - 2rem, var(--max));
		margin-inline: auto;
		display: grid;
		gap: var(--space-md);
		grid-template-columns: 1.2fr 1fr 1fr;
	}

	.footer-brand {
		font-family: var(--font-display);
		font-size: 1.4rem;
		margin: 0;
		color: var(--wine-deep);
	}

	.footer-tag,
	.footer-meta {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.92rem;
	}

	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}

	.site-footer a {
		text-decoration: none;
		color: var(--ink-soft);
		font-weight: 600;
		font-size: 0.92rem;
	}

	.site-footer a:hover {
		color: var(--wine);
	}

	.footer-contact {
		display: grid;
		gap: 0.4rem;
		align-content: start;
	}

	.footer-copy {
		width: min(100% - 2rem, var(--max));
		margin: var(--space-md) auto 0;
		padding-top: var(--space-sm);
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.82rem;
	}

	@media (max-width: 760px) {
		.footer-inner {
			grid-template-columns: 1fr;
		}
	}
</style>
