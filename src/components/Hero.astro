---
import { withBase } from '../lib/paths';

interface Props {
	brand: string;
	tagline: string;
	title: string;
	lead: string;
	primaryHref?: string;
	primaryLabel?: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	pills?: string[];
}

const {
	brand,
	tagline,
	title,
	lead,
	primaryHref = '/kontakty/',
	primaryLabel = 'Узнать, свободна ли дата',
	secondaryHref = '/galereya/',
	secondaryLabel = 'Посмотреть меня в деле',
	pills = ['Свадьбы', 'Юбилеи', 'Корпоративы'],
} = Astro.props;
---

<section class="hero" aria-label="Главный экран">
	<div class="hero-stage">
		<div class="hero-inner">
			<div class="hero-copy">
				<p class="hero-brand">
					<span class="hero-brand-name">{brand}</span>
					<span class="hero-brand-tag">{tagline}</span>
				</p>
				<h1>{title}</h1>
				<p class="hero-lead">{lead}</p>
				<div class="cta-row">
					<a class="btn btn-primary" href={withBase(primaryHref)}>{primaryLabel}</a>
					<a class="btn btn-ghost" href={withBase(secondaryHref)}>{secondaryLabel}</a>
				</div>
			</div>

			<div class="hero-visual" aria-hidden="true">
				<div class="hero-photo">
					<span class="hero-photo-label">Фото ведущего</span>
					<span class="hero-photo-hint">Плейсхолдер · замените реальным кадром</span>
				</div>
			</div>
		</div>
	</div>

	<div class="hero-strip">
		<div class="hero-strip-inner">
			<p class="hero-strip-tag">{tagline} · тёплый тон, ясный ритм, без лишнего шума</p>
			<ul class="hero-pills" aria-label="Форматы">
				{pills.map((pill) => <li class="hero-pill">{pill}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		background: var(--bg);
	}

	.hero-stage {
		position: relative;
		min-height: min(88vh, 48rem);
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.hero-stage::before {
		content: '';
		position: absolute;
		inset: auto -10% -20% 40%;
		height: 70%;
		background: radial-gradient(ellipse at center, color-mix(in srgb, var(--surfaces) 90%, transparent), transparent 68%);
		pointer-events: none;
		animation: softDrift 16s ease-in-out infinite alternate;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		width: min(100% - 2rem, var(--max));
		margin: 0 auto;
		padding: 5.5rem 0 3.5rem;
		display: grid;
		gap: var(--space-lg);
		align-items: center;
	}

	.hero-copy {
		max-width: 34rem;
		animation: riseIn 0.85s var(--ease-out) both;
	}

	.hero-brand {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0 0 1.35rem;
		animation: riseIn 0.85s var(--ease-out) 0.06s both;
	}

	.hero-brand-name {
		font-family: var(--font-display);
		font-size: clamp(3.2rem, 9vw, 5.6rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 0.92;
		color: var(--text);
	}

	.hero-brand-tag {
		font-family: var(--font-body);
		font-size: clamp(0.92rem, 1.6vw, 1.05rem);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h1 {
		margin: 0 0 1rem;
		font-size: clamp(1.55rem, 3vw, 2.2rem);
		font-weight: 700;
		max-width: 16ch;
		color: var(--text);
	}

	.hero-lead {
		margin: 0 0 1.75rem;
		font-size: 1.08rem;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 36ch;
	}

	.hero-visual {
		animation: riseIn 0.95s var(--ease-out) 0.14s both;
	}

	.hero-photo {
		aspect-ratio: 4 / 5;
		width: 100%;
		max-width: 28rem;
		margin-inline: auto;
		background:
			linear-gradient(160deg, color-mix(in srgb, var(--surfaces) 70%, var(--cards)) 0%, var(--surfaces) 48%, color-mix(in srgb, var(--accent) 18%, var(--surfaces)) 100%);
		border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		text-align: center;
		padding: 1.5rem;
		position: relative;
		overflow: hidden;
	}

	.hero-photo::after {
		content: '';
		position: absolute;
		inset: 12% 14%;
		border: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
		pointer-events: none;
		animation: framePulse 7s var(--ease-out) infinite alternate;
	}

	.hero-photo-label {
		position: relative;
		z-index: 1;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--text);
		letter-spacing: -0.01em;
	}

	.hero-photo-hint {
		position: relative;
		z-index: 1;
		font-size: 0.82rem;
		color: var(--muted);
		max-width: 16ch;
	}

	.hero-strip {
		background: var(--text);
		color: var(--cards);
	}

	.hero-strip-inner {
		width: min(100% - 2rem, var(--max));
		margin: 0 auto;
		padding: 1.15rem 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
	}

	.hero-strip-tag {
		margin: 0;
		font-size: 0.95rem;
		color: color-mix(in srgb, var(--cards) 78%, var(--surfaces));
		max-width: 36rem;
	}

	.hero-pills {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.hero-pill {
		padding: 0.4rem 0.85rem;
		border: 1px solid color-mix(in srgb, var(--cards) 28%, transparent);
		color: color-mix(in srgb, var(--cards) 92%, var(--surfaces));
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		animation: riseIn 0.7s var(--ease-out) both;
	}

	.hero-pill:nth-child(1) {
		animation-delay: 0.2s;
	}
	.hero-pill:nth-child(2) {
		animation-delay: 0.28s;
	}
	.hero-pill:nth-child(3) {
		animation-delay: 0.36s;
	}

	@keyframes riseIn {
		from {
			opacity: 0;
			transform: translateY(1.1rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes softDrift {
		from {
			transform: translate3d(0, 0, 0);
			opacity: 0.85;
		}
		to {
			transform: translate3d(-3%, 2%, 0);
			opacity: 1;
		}
	}

	@keyframes framePulse {
		from {
			opacity: 0.55;
			transform: scale(1);
		}
		to {
			opacity: 0.9;
			transform: scale(1.015);
		}
	}

	@media (min-width: 900px) {
		.hero-inner {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
			gap: var(--space-xl);
			padding: 6rem 0 4rem;
		}

		.hero-photo {
			margin-inline: 0 0;
			margin-left: auto;
		}
	}

	@media (max-width: 640px) {
		.hero-stage {
			min-height: auto;
		}

		.hero-inner {
			padding: 4.5rem 0 2.5rem;
		}

		.hero-lead {
			max-width: none;
		}

		.hero-strip-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
